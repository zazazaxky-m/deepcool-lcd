# Maintainer: zazazaxky-m
pkgname=deepcool-lcd
pkgver=1.0.0
pkgrel=1
pkgdesc="Custom screens and a GTK customizer for DeepCool LM-series AIO cooler LCDs"
arch=('any')
url="https://github.com/zazazaxky-m/deepcool-lcd"
license=('MIT' 'OFL-1.1' 'Bitstream-Vera')
depends=('python' 'python-pyusb' 'python-psutil' 'python-pillow' 'systemd')
optdepends=('python-gobject: DeepCool LCD Studio app'
            'gtk4: DeepCool LCD Studio app'
            'nvidia-utils: NVIDIA GPU stats')
conflicts=('deepcool-lm')
install=deepcool-lcd.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('bcad181774f3c982141161a11defdac95214555ae8839fbb788853456e5812ea')

check() {
    cd "$pkgname-$pkgver"
    python -m unittest discover -s tests -t .
}

package() {
    cd "$pkgname-$pkgver"
    make DESTDIR="$pkgdir" PREFIX=/usr install
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 data/fonts/OFL-FiraSans.txt "$pkgdir/usr/share/licenses/$pkgname/OFL-FiraSans.txt"
    install -Dm644 data/fonts/LICENSE-Hack.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE-Hack.md"
}
